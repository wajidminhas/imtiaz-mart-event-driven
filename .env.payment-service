# ============================================
# PAYMENT SERVICE - COMPLETE PORT CONFIGURATION
# ============================================
# Change ANY port here - internal or external!

# Service Metadata
PAYMENT_SERVICE_NAME=Payment Service
PAYMENT_SERVICE_VERSION=1.0.0
PAYMENT_SERVICE_APP_ID=payment-service

# ============================================
# APPLICATION PORTS
# ============================================
PAYMENT_SERVICE_EXTERNAL_PORT=8002   # Host machine port (localhost:8002)
PAYMENT_SERVICE_INTERNAL_PORT=8002   # Container internal port

# Why separate? You might want:
# - External: 8002 (what users access)
# - Internal: 8080 (what app runs on inside container)

# ============================================
# DAPR PORTS
# ============================================
PAYMENT_DAPR_HTTP_PORT=3502         # Dapr HTTP API
PAYMENT_DAPR_GRPC_PORT=50003        # Dapr gRPC API  
PAYMENT_DAPR_METRICS_PORT=9092      # Prometheus metrics

# ============================================
# DATABASE PORTS
# ============================================
PAYMENT_DB_NAME=payment_db
PAYMENT_DB_EXTERNAL_PORT=5434       # Host machine port (localhost:5434)
PAYMENT_DB_INTERNAL_PORT=5432       # PostgreSQL listens on this inside container

# Why 5432 internal? That's PostgreSQL default.
# But you CAN change it if needed (advanced use case)

# ============================================
# DAPR CONFIGURATION
# ============================================
DAPR_VERSION=latest
DAPR_LOG_LEVEL=debug                # info, debug, warn, error

# ============================================
# PUBSUB CONFIGURATION
# ============================================
PUBSUB_NAME=imtiaz-pubsub

# ============================================
# PAYMENT GATEWAYS
# ============================================
# PayFast (Pakistan - Local Payments)
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_PASSPHRASE=your_passphrase
PAYFAST_URL=https://sandbox.payfast.co.za/eng/process

# Stripe (International Payments)
STRIPE_API_KEY=sk_test_your_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================
# BUILD & GENERAL SETTINGS
# ============================================
BUILD_DATE=2025-12-27
DEBUG=true                          # false in production
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
