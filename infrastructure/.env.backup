# Database
POSTGRES_USER=imtiaz
POSTGRES_PASSWORD=password123

# Host ports (map to 5432 inside containers)
POSTGRES_HOST_PORT=5436      # For user-db
PRODUCT_DB_HOST_PORT=5437    # For product-db
ORDER_DB_HOST_PORT=5438      # For order-db (future)
INVENTORY_DB_HOST_PORT=5439  # For inventory-db (future)

# Database Names (use underscores for Python/SQL convention)
USER_DB_NAME=user_db         # ✅ Changed from userdb
PRODUCT_DB_NAME=product_db   # ✅ Changed from productdb
ORDER_DB_NAME=order_db
INVENTORY_DB_NAME=inventory_db
PAYMENT_DB_NAME=payment_db
NOTIFICATION_DB_NAME=notification_db

# Services
USER_SERVICE_PORT=8000
PRODUCT_SERVICE_PORT=8001
PAYMENT_SERVICE_PORT=8002
ORDER_SERVICE_PORT=8003
INVENTORY_SERVICE_PORT=8004

# Environment
DEBUG=true

# JWT (for User Service)
USER_SERVICE_SECRET_KEY=your_strong_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30


# Order Service Configuration
ORDER_DB_NAME=order_db
ORDER_SERVICE_PORT=8003
