# ==============================================
# Imtiaz Mart - Infrastructure Configuration
# ==============================================
# Copy this file to .env and update values
# NEVER commit .env to Git!

# ============================================
# PostgreSQL Database Configuration
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_HOST_PORT=5436

# Database Names (one per service)
USER_DB_NAME=userdb
PRODUCT_DB_NAME=productdb
ORDER_DB_NAME=orderdb
INVENTORY_DB_NAME=inventorydb
PAYMENT_DB_NAME=paymentdb
NOTIFICATION_DB_NAME=notificationdb

# ============================================
# User Service Configuration
# ============================================
USER_SERVICE_PORT=8000
USER_SERVICE_SECRET_KEY=generate_a_secure_key_here_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# Product Service Configuration
# ============================================
PRODUCT_SERVICE_PORT=8001

# ============================================
# Order Service Configuration
# ============================================
ORDER_SERVICE_PORT=8002

# ============================================
# Other Services (Add as you build them)
# ============================================
INVENTORY_SERVICE_PORT=8003
PAYMENT_SERVICE_PORT=8004
NOTIFICATION_SERVICE_PORT=8005

# ============================================
# Application Configuration
# ============================================
DEBUG=True
