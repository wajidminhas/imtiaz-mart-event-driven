

networks:
  imtiaz-network:
    driver: bridge

services:
  

  kafka:
    image: confluentinc/cp-kafka:7.5.0
    container_name: imtiaz-kafka
    networks:
      - imtiaz-network
    ports:
      - "9092:9092"
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_LISTENERS: PLAINTEXT://kafka:29092,PLAINTEXT_HOST://0.0.0.0:9092,CONTROLLER://kafka:29093
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT,CONTROLLER:PLAINTEXT
      KAFKA_INTER_BROKER_LISTENER_NAME: PLAINTEXT
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@kafka:29093
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_AUTO_CREATE_TOPICS_ENABLE: "true"
      CLUSTER_ID: MkU3OEVBNTcwNTJENDM2Qk
    healthcheck:
      test: ["CMD-SHELL", "kafka-broker-api-versions --bootstrap-server localhost:9092 || exit 1"]
      interval: 10s
      timeout: 10s
      retries: 5
      start_period: 30s
    restart: unless-stopped


  # Add this NEW service right here ⬇️
  kafka-ui:
    image: provectuslabs/kafka-ui:latest
    container_name: imtiaz-kafka-ui
    networks:
      - imtiaz-network
    ports:
      - "8080:8080"
    environment:
      KAFKA_CLUSTERS_0_NAME: imtiaz-kafka
      KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS: kafka:29092
      # Remove ZOOKEEPER line
    depends_on:
      - kafka
    restart: unless-stopped  

  # Then your product-db service continues below...
  #product-db:
    #image: postgres:16-alpine
    # ...

  # ========================================
  # PRODUCT SERVICE
  # ========================================
  product-db:
    image: postgres:16-alpine
    container_name: imtiaz-product-db
    networks:
      - imtiaz-network
    environment:
      - POSTGRES_USER=${POSTGRES_USER}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_DB=${PRODUCT_DB_NAME}
      - PGPORT=${PRODUCT_DB_INTERNAL_PORT:-5432}
    volumes:
      - product-db-data:/var/lib/postgresql/data
    ports:
      - "${PRODUCT_DB_EXTERNAL_PORT:-5437}:${PRODUCT_DB_INTERNAL_PORT:-5432}"  # ✅ Dynamic both sides
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -p ${PRODUCT_DB_INTERNAL_PORT:-5432}"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped

  product-service:
    build:
      context: ../services/product-service
      dockerfile: Dockerfile
      args:
        VERSION: "1.0.0"
        BUILD_DATE: "${BUILD_DATE:-2025-11-09}"
        APP_PORT: "${PRODUCT_SERVICE_INTERNAL_PORT:-8001}"  # ✅ Pass to Dockerfile
    image: imtiaz-mart/product-service:1.0.0
    container_name: imtiaz-product-service
    networks:
      - imtiaz-network
    ports:
      - "${PRODUCT_SERVICE_EXTERNAL_PORT:-8001}:${PRODUCT_SERVICE_INTERNAL_PORT:-8001}"  # ✅ Both dynamic!
    environment:
      - DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@product-db:${PRODUCT_DB_INTERNAL_PORT:-5432}/${PRODUCT_DB_NAME}
      - APP_NAME=Product Service
      - APP_PORT=${PRODUCT_SERVICE_INTERNAL_PORT:-8001}  # ✅ Dynamic
      - DEBUG=${DEBUG:-true}
      - DAPR_HTTP_PORT=${PRODUCT_DAPR_HTTP_PORT:-3501}  # ✅ Dynamic
      - DAPR_GRPC_PORT=${PRODUCT_DAPR_GRPC_PORT:-50001}  # ✅ Dynamic
      - PUBSUB_NAME=${PUBSUB_NAME:-imtiaz-pubsub}
    volumes:
      - ../services/product-service:/app
    depends_on:
      product-db:
        condition: service_healthy
      kafka:
        condition: service_healthy
    restart: unless-stopped

  product-service-dapr:
    image: daprio/daprd:latest
    container_name: imtiaz-product-service-dapr
    command: ./daprd -app-id product-service -app-port 8001 -dapr-http-port 3501 -dapr-grpc-port 50001 -components-path /components -config /config/config.yaml -log-level debug
    volumes:
      - ./dapr/components:/components:ro
      - ./dapr/config.yaml:/config/config.yaml:ro
    depends_on:
      - product-service
      - kafka
    network_mode: "service:product-service"
    restart: unless-stopped

   # ========================================
  # USER SERVICE
  # ========================================
  user-db:
    image: postgres:16-alpine
    container_name: imtiaz-user-db
    networks:
      - imtiaz-network
    environment:
      - POSTGRES_USER=${POSTGRES_USER}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_DB=${USER_DB_NAME}
      - PGPORT=${USER_DB_INTERNAL_PORT:-5432}
    volumes:
      - user-db-data:/var/lib/postgresql/data
    ports:
      - "${USER_DB_EXTERNAL_PORT:-5436}:${USER_DB_INTERNAL_PORT:-5432}"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -p ${USER_DB_INTERNAL_PORT:-5432}"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped

  user-service:
    build:
      context: ../services/user-service
      dockerfile: Dockerfile
      args:
        VERSION: "1.0.0"
        BUILD_DATE: "${BUILD_DATE:-2025-12-27}"
        APP_PORT: "${USER_SERVICE_INTERNAL_PORT:-8000}"
    image: imtiaz-mart/user-service:1.0.0
    container_name: imtiaz-user-service
    networks:
      - imtiaz-network
    ports:
      - "${USER_SERVICE_EXTERNAL_PORT:-8000}:${USER_SERVICE_INTERNAL_PORT:-8000}"
    environment:
      - DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@user-db:${USER_DB_INTERNAL_PORT:-5432}/${USER_DB_NAME}
      - APP_NAME=User Service
      - APP_PORT=${USER_SERVICE_INTERNAL_PORT:-8000}
      - DEBUG=${DEBUG:-true}
      - DAPR_HTTP_PORT=${USER_DAPR_HTTP_PORT:-3500}
      - DAPR_GRPC_PORT=${USER_DAPR_GRPC_PORT:-50000}
      - PUBSUB_NAME=${PUBSUB_NAME:-imtiaz-pubsub}
      - SECRET_KEY=${USER_SERVICE_SECRET_KEY}
      - ALGORITHM=${ALGORITHM:-HS256}
      - ACCESS_TOKEN_EXPIRE_MINUTES=${ACCESS_TOKEN_EXPIRE_MINUTES:-30}
    volumes:
      - ../services/user-service:/app
    depends_on:
      user-db:
        condition: service_healthy
      kafka:
        condition: service_healthy
    restart: unless-stopped

  user-service-dapr:
    image: daprio/daprd:latest
    container_name: imtiaz-user-service-dapr
    command: ./daprd -app-id user-service -app-port 8000 -dapr-http-port 3500 -dapr-grpc-port 50000 -components-path /components -config /config/config.yaml -log-level debug
    volumes:
      - ./dapr/components:/components:ro
      - ./dapr/config.yaml:/config/config.yaml:ro
    depends_on:
      - user-service
      - kafka
    network_mode: "service:user-service"
    restart: unless-stopped

  # ========================================
  # ORDER SERVICE
  # ========================================
  order-db:
    image: postgres:16-alpine
    container_name: imtiaz-order-db
    networks:
      - imtiaz-network
    environment:
      - POSTGRES_USER=${POSTGRES_USER}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_DB=${ORDER_DB_NAME}
      - PGPORT=${ORDER_DB_INTERNAL_PORT:-5432}
    volumes:
      - order-db-data:/var/lib/postgresql/data
    ports:
      - "${ORDER_DB_EXTERNAL_PORT:-5438}:${ORDER_DB_INTERNAL_PORT:-5432}"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -p ${ORDER_DB_INTERNAL_PORT:-5432}"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped

  order-service:
    build:
      context: ../services/order-service
      dockerfile: Dockerfile
      args:
        VERSION: "1.0.0"
        BUILD_DATE: "${BUILD_DATE:-2025-12-27}"
        APP_PORT: "${ORDER_SERVICE_INTERNAL_PORT:-8003}"
    image: imtiaz-mart/order-service:1.0.0
    container_name: imtiaz-order-service
    networks:
      - imtiaz-network
    ports:
      - "${ORDER_SERVICE_EXTERNAL_PORT:-8003}:${ORDER_SERVICE_INTERNAL_PORT:-8003}"
    environment:
      - DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@order-db:${ORDER_DB_INTERNAL_PORT:-5432}/${ORDER_DB_NAME}
      - APP_NAME=Order Service
      - APP_PORT=${ORDER_SERVICE_INTERNAL_PORT:-8003}
      - DEBUG=${DEBUG:-true}
      - DAPR_HTTP_PORT=${ORDER_DAPR_HTTP_PORT:-3503}
      - DAPR_GRPC_PORT=${ORDER_DAPR_GRPC_PORT:-50003}
      - PUBSUB_NAME=${PUBSUB_NAME:-imtiaz-pubsub}
    volumes:
      - ../services/order-service:/app
    depends_on:
      order-db:
        condition: service_healthy
      kafka:
        condition: service_healthy
    restart: unless-stopped

  order-service-dapr:
    image: daprio/daprd:latest
    container_name: imtiaz-order-service-dapr
    command: ./daprd -app-id order-service -app-port 8003 -dapr-http-port 3503 -dapr-grpc-port 50003 -components-path /components -config /config/config.yaml -log-level debug
    volumes:
      - ./dapr/components:/components:ro
      - ./dapr/config.yaml:/config/config.yaml:ro
    depends_on:
      - order-service
      - kafka
    network_mode: "service:order-service"
    restart: unless-stopped

  # ========================================
  # INVENTORY SERVICE
  # ========================================
  inventory-db:
    image: postgres:16-alpine
    container_name: imtiaz-inventory-db
    networks:
      - imtiaz-network
    environment:
      - POSTGRES_USER=${POSTGRES_USER}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_DB=${INVENTORY_DB_NAME}
      - PGPORT=${INVENTORY_DB_INTERNAL_PORT:-5432}
    volumes:
      - inventory-db-data:/var/lib/postgresql/data
    ports:
      - "${INVENTORY_DB_EXTERNAL_PORT:-5439}:${INVENTORY_DB_INTERNAL_PORT:-5432}"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -p ${INVENTORY_DB_INTERNAL_PORT:-5432}"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped

  inventory-service:
    build:
      context: ../services/inventory-service
      dockerfile: Dockerfile
      args:
        VERSION: "1.0.0"
        BUILD_DATE: "${BUILD_DATE:-2025-12-27}"
        APP_PORT: "${INVENTORY_SERVICE_INTERNAL_PORT:-8004}"
    image: imtiaz-mart/inventory-service:1.0.0
    container_name: imtiaz-inventory-service
    networks:
      - imtiaz-network
    ports:
      - "${INVENTORY_SERVICE_EXTERNAL_PORT:-8004}:${INVENTORY_SERVICE_INTERNAL_PORT:-8004}"
    environment:
      - DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@inventory-db:${INVENTORY_DB_INTERNAL_PORT:-5432}/${INVENTORY_DB_NAME}
      - APP_NAME=Inventory Service
      - APP_PORT=${INVENTORY_SERVICE_INTERNAL_PORT:-8004}
      - DEBUG=${DEBUG:-true}
      - DAPR_HTTP_PORT=${INVENTORY_DAPR_HTTP_PORT:-3504}
      - DAPR_GRPC_PORT=${INVENTORY_DAPR_GRPC_PORT:-50004}
      - PUBSUB_NAME=${PUBSUB_NAME:-imtiaz-pubsub}
    volumes:
      - ../services/inventory-service:/app
    depends_on:
      inventory-db:
        condition: service_healthy
      kafka:
        condition: service_healthy
    restart: unless-stopped

  inventory-service-dapr:
    image: daprio/daprd:latest
    container_name: imtiaz-inventory-service-dapr
    command: ./daprd -app-id inventory-service -app-port 8004 -dapr-http-port 3504 -dapr-grpc-port 50004 -components-path /components -config /config/config.yaml -log-level debug
    volumes:
      - ./dapr/components:/components:ro
      - ./dapr/config.yaml:/config/config.yaml:ro
    depends_on:
      - inventory-service
      - kafka
    network_mode: "service:inventory-service"
    restart: unless-stopped

# ========================================
  # PAYMENT SERVICE
  # ========================================
  payment-db:
    image: postgres:16-alpine
    container_name: imtiaz-payment-db
    networks:
      - imtiaz-network
    environment:
      - POSTGRES_USER=${POSTGRES_USER}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_DB=${PAYMENT_DB_NAME}
      - PGPORT=${PAYMENT_DB_INTERNAL_PORT:-5432}
    volumes:
      - payment-db-data:/var/lib/postgresql/data
    ports:
      - "${PAYMENT_DB_EXTERNAL_PORT:-5440}:${PAYMENT_DB_INTERNAL_PORT:-5432}"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -p ${PAYMENT_DB_INTERNAL_PORT:-5432}"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped

  payment-service:
    build:
      context: ../services/payment-service
      dockerfile: Dockerfile
      args:
        VERSION: "1.0.0"
        BUILD_DATE: "${BUILD_DATE:-2025-12-27}"
        APP_PORT: "${PAYMENT_SERVICE_INTERNAL_PORT:-8002}"
    image: imtiaz-mart/payment-service:1.0.0
    container_name: imtiaz-payment-service
    networks:
      - imtiaz-network
    ports:
      - "${PAYMENT_SERVICE_EXTERNAL_PORT:-8002}:${PAYMENT_SERVICE_INTERNAL_PORT:-8002}"
    environment:
      - DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@payment-db:${PAYMENT_DB_INTERNAL_PORT:-5432}/${PAYMENT_DB_NAME}
      - APP_NAME=Payment Service
      - APP_PORT=${PAYMENT_SERVICE_INTERNAL_PORT:-8002}
      - DEBUG=${DEBUG:-true}
      - DAPR_HTTP_PORT=${PAYMENT_DAPR_HTTP_PORT:-3502}
      - DAPR_GRPC_PORT=${PAYMENT_DAPR_GRPC_PORT:-50002}
      - PUBSUB_NAME=${PUBSUB_NAME:-imtiaz-pubsub}
      - PAYFAST_MERCHANT_ID=${PAYFAST_MERCHANT_ID}
      - PAYFAST_MERCHANT_KEY=${PAYFAST_MERCHANT_KEY}
      - PAYFAST_PASSPHRASE=${PAYFAST_PASSPHRASE}
      - PAYFAST_URL=${PAYFAST_URL}
      - STRIPE_API_KEY=${STRIPE_API_KEY}
      - STRIPE_WEBHOOK_SECRET=${STRIPE_WEBHOOK_SECRET}
    volumes:
      - ../services/payment-service:/app
    depends_on:
      payment-db:
        condition: service_healthy
      kafka:
        condition: service_healthy
    restart: unless-stopped

  payment-service-dapr:
    image: daprio/daprd:${DAPR_VERSION:-latest}
    container_name: imtiaz-payment-service-dapr
    command: ./daprd -app-id payment-service -app-port 8002 -dapr-http-port 3502 -dapr-grpc-port 50002 -components-path /components -config /config/config.yaml -log-level debug
    volumes:
      - ./dapr/components:/components:ro
      - ./dapr/config.yaml:/config/config.yaml:ro
    depends_on:
      - payment-service
      - kafka
    network_mode: "service:payment-service"
    restart: unless-stopped

# ========================================
# VOLUMES (Add these at the bottom of docker-compose.yml)
# ========================================
volumes:
  user-db-data:
    name: imtiaz-user-db-data
  order-db-data:
    name: imtiaz-order-db-data
  inventory-db-data:
    name: imtiaz-inventory-db-data
  product-db-data:
    name: imtiaz-product-db-data
  payment-db-data:
    name: imtiaz-payment-db-data
